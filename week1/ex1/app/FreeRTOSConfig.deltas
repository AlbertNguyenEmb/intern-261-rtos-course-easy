# Ex1 — các định nghĩa phải có trong FreeRTOSConfig.h
#
# Điền giá trị vào chỗ <?>. Đây là file bạn nộp; copy sang FreeRTOSConfig.h thật.
# Mỗi dòng phải giải thích được trong buổi vấn đáp.
// Clock and time system
configCPU_CLOCK_HZ                      <SystemCoreClock>
configTICK_RATE_HZ                      1000
// task and memory configuration
configMAX_PRIORITIES                    <5>
configMINIMAL_STACK_SIZE                <128>
configTOTAL_HEAP_SIZE                   <8 * 1024>
configUSE_PREEMPTION                    1
configUSE_PORT_OPTIMISED_TASK_SELECTION 0
configCHECK_FOR_STACK_OVERFLOW          <0>
configUSE_MALLOC_FAILED_HOOK            <0>

configPRIO_BITS                         <__NVIC_PRIO_BITS>
configLIBRARY_LOWEST_INTERRUPT_PRIORITY         <15>
configLIBRARY_MAX_SYSCALL_INTERRUPT_PRIORITY    <5>

# Ba handler kernel chiếm — map tên port sang tên trong vector table:
# vPortSVCHandler        -> <SVC_Handler>
# xPortPendSVHandler     -> <PendSV_Handler>
# xPortSysTickHandler    -> <SysTick_Handler>
